    RecordSource ="SELECT T_Leistungen.ProjektID, T_Projekte.ProjektName, T_Projekte.Beschreibung, "
        "T_Projekte.StartDatum, T_Projekte.EndDatum, A_KundenListe.Kundenname, T_Rechnung"
        "en.Anschriftname, T_Leistungen.Datum, T_Leistungen.Von, T_Leistungen.Bis, T_Leis"
        "tungen.Menge, T_Leistungen.Einheit, T_Leistungen.Anmerkungen AS [Text], Year([T_"
        "Leistungen].[Datum])*100+Month([T_Leistungen].[Datum]) AS JahrMonat, T_Leistunge"
        "n.KarteiID, T_Leistungen.AufRechnungID, T_Produkte.Beschreibung AS ProduktName, "
        "T_Rechnungen.Nr AS RechnungNr, IIf(IsNull([T_Rechnungen].[ID]),Null,[T_Leistunge"
        "n].[Menge]) AS MengeVerr_, T_Projekte.Pauschalverrechnung, T_Projekte.Pauschalbe"
        "trag, T_Projekte.PauschalStd FROM T_Produkte RIGHT JOIN (((T_Leistungen LEFT JOI"
        "N T_Rechnungen ON T_Leistungen.AufRechnungID = T_Rechnungen.ID) INNER JOIN T_Pro"
        "jekte ON T_Leistungen.ProjektID = T_Projekte.ID) INNER JOIN A_KundenListe ON T_P"
        "rojekte.KarteiID = A_KundenListe.ID) ON T_Produkte.ID = T_Leistungen.ProduktID W"
