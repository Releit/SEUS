    RecordSource ="SELECT T_RechnungsPos.RechnungID, T_RechnungsPos.ID AS PosID, [T_Rechnungen].[An"
        "schriftname] & Nz(Chr(13)+Chr(10)+[T_Rechnungen].[zuhanden]) AS Kundenname, T_Re"
        "chnungen.Adresse, IIf([T_Rechnungen].[Landcode]<>\"A\",[T_Rechnungen].[Landcode]"
        "+\"-\",\"\") & [T_Rechnungen].[PLZ] & \" \" & [T_Rechnungen].[Ort] AS PLZOrt, T_"
        "Rechnungen.UID, T_Rechnungen.Datum, T_Rechnungen.Nr, T_RechnungsPos.Datum, [Meng"
        "e] & \" \" & [Einheit] AS MengeEinheit, IIf(IsNull([Beschreibung]),\"\",[Beschre"
        "ibung]+Chr(13)+Chr(10)) & [T_RechnungsPos].[anmerkungen] AS PosText, T_Rechnungs"
        "Pos.VKexkl, T_RechnungsPos.UStProz, T_RechnungsPos.Menge, T_Zahlungsarten.Rechnu"
        "ngsText, ([kurzzeichen]+\"-\") & Format([T_Rechnungen].[Nr]) AS RNr, IIf([UstPro"
        "z]=0.1,Round([UstProz]*[VKexkl]*[menge],2),Null) AS Ust10Proz, IIf([UstProz]=0.1"
        "2,Round([UstProz]*[VKexkl]*[menge],2),Null) AS Ust12Proz, IIf([UstProz]=0.2,Roun"
        "d([UstProz]*[VKexkl]*[menge],2),Null) AS Ust20Proz, [VKexkl]*[Menge] AS Gesamt, "
        "IIf(IsNull([T_Rechnungen].[uid]),Null,\"Ihre UID:\") AS UIDNrTxt, T_Rechnungen.D"
        "ruckText, T_RechnungsPos.Beschreibung, T_RechnungsPos.Anmerkungen, mED_GetMemo(\""
        "RechnungsFussText\") AS RechnungsFussText, T_RechnungsPos.Pos FROM (T_Rechnungen"
        " INNER JOIN T_Zahlungsarten ON T_Rechnungen.ZahlartID = T_Zahlungsarten.ID) INNE"
        "R JOIN T_RechnungsPos ON T_Rechnungen.ID = T_RechnungsPos.RechnungID WHERE (((T_"
        "RechnungsPos.RechnungID)=mBR_GetID())); "
