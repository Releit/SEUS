    RecordSource ="SELECT T_Lieferscheine.ID AS LieferscheinID, T_Lieferscheine.Datum, T_Liefersche"
        "ine.Nr, T_Kartei.Nr AS KNr, T_Lieferscheine.KarteiID, Nz([T_Adressen].[Anrede],["
        "T_Kartei].[Anrede]) AS Anrede, T_Lieferscheine.ZuHanden, [T_Kartei].[Name1] & ' "
        "' & [T_Kartei].[Name2] AS Kundenname, Nz([T_Adressen].[Name1],[T_Kartei].[Name1]"
        ") & ' ' & Nz([T_Adressen].[Name2],[T_Kartei].[Name2]) AS Anschriftname, Nz([T_Ad"
        "ressen].[Adresse],[T_Kartei].[Adresse]) AS Adresse, Nz([T_Adressen].[PLZ],[T_Kar"
        "tei].[PLZ]) AS PLZ, Nz([T_Adressen].[Ort],[T_Kartei].[Ort]) AS Ort, Nz([tel],[mo"
        "bil]) AS TelMobil, Nz([mobil],\"F:\"+[fax]) AS MobilFax FROM T_Kartei INNER JOIN"
        " (T_Adressen RIGHT JOIN T_Lieferscheine ON T_Adressen.ID = T_Lieferscheine.Adres"
        "senID) ON T_Kartei.ID = T_Lieferscheine.KarteiID GROUP BY T_Lieferscheine.ID, T_"
        "Lieferscheine.Datum, T_Lieferscheine.Nr, T_Kartei.Nr, T_Lieferscheine.KarteiID, "
        "Nz([T_Adressen].[Anrede],[T_Kartei].[Anrede]), T_Lieferscheine.ZuHanden, [T_Kart"
        "ei].[Name1] & ' ' & [T_Kartei].[Name2], Nz([T_Adressen].[Name1],[T_Kartei].[Name"
        "1]) & ' ' & Nz([T_Adressen].[Name2],[T_Kartei].[Name2]), Nz([T_Adressen].[Adress"
        "e],[T_Kartei].[Adresse]), Nz([T_Adressen].[PLZ],[T_Kartei].[PLZ]), Nz([T_Adresse"
        "n].[Ort],[T_Kartei].[Ort]), Nz([tel],[mobil]), Nz([mobil],\"F:\"+[fax]) HAVING ("
        "((T_Lieferscheine.ID)=mBR_GetID())); "
