    RecordSource ="SELECT T_RechnungsPos.RechnungID, T_RechnungsPos.ID AS PosID, IIf(IsNull([Adress"
        "enID]),Nz([T_Kartei].[Titel]+\" \",\"\") & [T_Kartei].[Name1] & \" \" & (Chr(13)"
        "+Chr(10)+[T_Kartei].[Name2]),Nz([T_Adressen].[Titel]+\" \",\"\") & [T_Adressen]."
        "[Name1] & \" \" & (Chr(13)+Chr(10)+[T_Adressen].[Name2])) & Nz(Chr(13)+Chr(10)+["
        "T_Rechnungen].[zuhanden],\"\") AS Kundenname, T_Kartei.Adresse, IIf(IsNull([Adre"
        "ssenID]),IIf([T_Kartei].[Landcode]<>\"A\",[T_Kartei].[Landcode]+\"-\",\"\") & [T"
        "_Kartei].[PLZ] & \" \" & [T_Kartei].[Ort],[T_Adressen].[PLZ] & \" \" & [T_Adress"
        "en].[Ort]) AS PLZOrt, T_Rechnungen.Datum, T_Rechnungen.Nr, T_RechnungsPos.Datum,"
        " [Menge] & \" \" & [Einheit] AS MengeEinheit, IIf(IsNull([Beschreibung]),\"\",[B"
        "eschreibung]+Chr(13)+Chr(10)) & [T_RechnungsPos].[anmerkungen] AS PosText, T_Rec"
        "hnungsPos.VKexkl, T_RechnungsPos.UStProz, T_RechnungsPos.Menge, T_Zahlungsarten."
        "RechnungsText, ([kurzzeichen]+\"-\") & Format([T_Rechnungen].[Nr]) AS RNr, T_Kar"
        "tei.UID, IIf([UstProz]=0.1,Round([UstProz]*[VKexkl]*[menge],2),Null) AS Ust10Pro"
        "z, IIf([UstProz]=0.12,Round([UstProz]*[VKexkl]*[menge],2),Null) AS Ust12Proz, II"
        "f([UstProz]=0.2,Round([UstProz]*[VKexkl]*[menge],2),Null) AS Ust20Proz, [VKexkl]"
        "*[Menge] AS Gesamt, IIf(IsNull([T_Kartei].[uid]),Null,\"Ihre UID:\") AS UIDNrTxt"
        ", T_Rechnungen.DruckText, T_RechnungsPos.Beschreibung, T_RechnungsPos.Anmerkunge"
        "n, mED_GetMemo(\"RechnungsFussText\") AS RechnungsFussText FROM T_Kartei INNER J"
        "OIN (((T_Rechnungen INNER JOIN T_Zahlungsarten ON T_Rechnungen.ZahlartID = T_Zah"
        "lungsarten.ID) LEFT JOIN T_Adressen ON T_Rechnungen.AdressenID = T_Adressen.ID) "
        "INNER JOIN T_RechnungsPos ON T_Rechnungen.ID = T_RechnungsPos.RechnungID) ON T_K"
        "artei.ID = T_Rechnungen.KarteiID WHERE (((T_RechnungsPos.RechnungID)=mBR_GetID()"
        ")); "
