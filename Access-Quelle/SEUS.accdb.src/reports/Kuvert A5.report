    End
    RecordSource ="SELECT T_RechnungsPos.RechnungID, T_RechnungsPos.ID AS PosID, IIf(IsNull([Adress"
        "enID]),Nz([T_Kartei].[Titel]+\" \",\"\") & [T_Kartei].[Name1] & \" \" & (Chr(13)"
        "+Chr(10)+[T_Kartei].[Name2]),Nz([T_Adressen].[Titel]+\" \",\"\") & [T_Adressen]."
        "[Name1] & \" \" & (Chr(13)+Chr(10)+[T_Adressen].[Name2])) & Nz(Chr(13)+Chr(10)+["
        "T_Rechnungen].[zuhanden],\"\") AS Kundenname, IIf(IsNull([AdressenID]),[T_Kartei"
        "].[Adresse],[T_Adressen].[Adresse]) AS Adresse_, IIf(IsNull([AdressenID]),IIf([T"
        "_Kartei].[Landcode]<>\"A\",[T_Kartei].[Landcode]+\"-\",\"\") & [T_Kartei].[PLZ] "
        "& \" \" & [T_Kartei].[Ort],[T_Adressen].[PLZ] & \" \" & [T_Adressen].[Ort]) AS P"
        "LZOrt, T_Rechnungen.Datum, T_Rechnungen.Nr, T_RechnungsPos.Datum, [Menge] & \" \""
        " & [Einheit] AS MengeEinheit, IIf(IsNull([Beschreibung]),\"\",[Beschreibung]+Chr"
        "(13)+Chr(10)) & [T_RechnungsPos].[anmerkungen] AS PosText, T_RechnungsPos.VKexkl"
        ", T_RechnungsPos.UStProz, T_RechnungsPos.Menge, T_Zahlungsarten.RechnungsText, ("
        "[kurzzeichen]+\"-\") & Format([T_Rechnungen].[Nr]) AS RNr, T_Kartei.UID, IIf([Us"
        "tProz]=0.1,Round([UstProz]*[VKexkl]*[menge],2),Null) AS Ust10Proz, IIf([UstProz]"
        "=0.12,Round([UstProz]*[VKexkl]*[menge],2),Null) AS Ust12Proz, IIf([UstProz]=0.2,"
        "Round([UstProz]*[VKexkl]*[menge],2),Null) AS Ust20Proz, [VKexkl]*[Menge] AS Gesa"
        "mt, IIf(IsNull([T_Kartei].[uid]),Null,\"Ihre UID:\") AS UIDNrTxt, T_Rechnungen.D"
        "ruckText, T_RechnungsPos.Beschreibung, T_RechnungsPos.Anmerkungen, mED_GetMemo(\""
        "RechnungsFussText\") AS RechnungsFussText FROM (T_Kartei INNER JOIN ((T_Rechnung"
        "en INNER JOIN T_Zahlungsarten ON T_Rechnungen.ZahlartID = T_Zahlungsarten.ID) LE"
        "FT JOIN T_Adressen ON T_Rechnungen.AdressenID = T_Adressen.ID) ON T_Kartei.ID = "
        "T_Rechnungen.KarteiID) INNER JOIN T_RechnungsPos ON T_Rechnungen.ID = T_Rechnung"
        "sPos.RechnungID WHERE (((T_RechnungsPos.RechnungID)=mBR_GetID())); "
    DatasheetFontName ="Tahoma"
