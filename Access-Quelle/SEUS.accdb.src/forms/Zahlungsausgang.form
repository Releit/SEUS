                    RowSourceType ="Table/Query"
                    RowSource ="SELECT T_EingangsRechnungen.ID, T_EingangsRechnungen.Datum, T_EingangsRechnungen"
                        ".Brutto, Abs(Sum(Nz([T_EingangsRechnungen_ZA].[Betrag],0))-[T_EingangsRechnungen"
                        "].[Brutto]-Nz([T_EingangsRechnungen].[skonto],0)) AS Ausdr1, T_EingangsRechnunge"
                        "n.Skonto FROM T_EingangsRechnungen LEFT JOIN T_EingangsRechnungen_ZA ON T_Eingan"
                        "gsRechnungen.ID = T_EingangsRechnungen_ZA.ERID WHERE (((T_EingangsRechnungen.Lie"
