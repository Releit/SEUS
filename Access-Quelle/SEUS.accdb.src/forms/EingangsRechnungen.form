                    RowSourceType ="Table/Query"
                    RowSource ="SELECT T_Zahlungsausgänge.ID, T_Zahlungsausgänge.Datum, T_Zahlungsausgänge.Betra"
                        "g, Abs(Sum(Nz([T_EingangsRechnungen_ZA].[Betrag],0))-[T_Zahlungsausgänge].[Betra"
                        "g]) AS Ausdr1\015\012FROM T_Zahlungsausgänge LEFT JOIN T_EingangsRechnungen_ZA O"
                        "N T_Zahlungsausgänge.ID = T_EingangsRechnungen_ZA.ZAID\015\012WHERE (((T_Zahlung"
                        "sausgänge.KarteiID)=[Formulare]![EingangsRechnungen]![LiefKarteiID]))\015\012GRO"
                        "UP BY T_Zahlungsausgänge.ID, T_Zahlungsausgänge.Datum, T_Zahlungsausgänge.Betrag"
                        ", T_Zahlungsausgänge.Datum\015\012HAVING (((Abs(Sum(Nz([T_EingangsRechnungen_ZA]"
                        ".[Betrag],0))-[T_Zahlungsausgänge].[Betrag]))>=0.005))\015\012ORDER BY T_Zahlung"
                        "sausgänge.Datum;\015\012"
