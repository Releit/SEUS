    RecordSource ="SELECT T_Kartei.ID, T_Kartei.Nr, [Name1] & \" \" & [Name2] AS Kundenname, T_Kart"
        "ei.PLZ, T_Kartei.Ort, T_Kartei.Adresse, T_Kartei.Anrede, T_Kartei.Titel, T_Karte"
        "i.Tel, T_Kartei.Fax, Max(T_Leistungen.Datum) AS MaxvonDatum FROM (T_Kartei LEFT "
        "JOIN T_KarteiFlags ON T_Kartei.ID = T_KarteiFlags.KarteiID) LEFT JOIN T_Leistung"
        "en ON T_Kartei.ID = T_Leistungen.KarteiID WHERE (((IIf(mFD_GetFlagID(),[FlagID],"
        "0))=mFD_GetFlagID())) GROUP BY T_Kartei.ID, T_Kartei.Nr, [Name1] & \" \" & [Name"
        "2], T_Kartei.PLZ, T_Kartei.Ort, T_Kartei.Adresse, T_Kartei.Anrede, T_Kartei.Tite"
        "l, T_Kartei.Tel, T_Kartei.Fax ORDER BY [Name1] & \" \" & [Name2]; "
