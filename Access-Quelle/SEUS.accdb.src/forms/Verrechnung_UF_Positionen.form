    RecordSource ="SELECT T_Leistungen.VerrKndID, T_Leistungen.KarteiID, Count(T_Leistungen.ID) AS "
        "AnzahlvonID, Sum(T_Leistungen.Menge) AS SummevonMenge, T_Produkte.Einheit, T_Pro"
        "dukte.Beschreibung AS Produkt, \"\" AS Anmerkungen, T_Projekte.ProjektName, T_Le"
        "istungen.Datum FROM T_Produkte INNER JOIN (T_Leistungen LEFT JOIN T_Projekte ON "
        "T_Leistungen.ProjektID = T_Projekte.ID) ON T_Produkte.ID = T_Leistungen.ProduktI"
        "D WHERE (((T_Leistungen.Menge)<>0) AND ((T_Leistungen.VKExkl)<>0) AND ((Nz([Paus"
        "chalverrechnung],0))<>0)) GROUP BY T_Leistungen.VerrKndID, T_Leistungen.KarteiID"
        ", T_Produkte.Einheit, T_Produkte.Beschreibung, \"\", T_Projekte.ProjektName, T_L"
        "eistungen.Datum HAVING (((T_Leistungen.VerrKndID)=[Formulare]![Verrechnung]![UF_"
        "Kunden].[Formular]![ID])) ORDER BY T_Produkte.Beschreibung; "
